# Groq LLM (required for /generate-report)
GROQ_API_KEY=your_groq_api_key_here

# Groq model for advisory generation (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Bhashini Translation (primary - get an inference API key at bhashini.gov.in).
# Sent as the Authorization header; no user ID or ULCA handshake is required.
BHASHINI_API_KEY=your_bhashini_api_key_here

# Falls back to MyMemory (free, no key) if Bhashini is unavailable.

# Google Cloud Translation (unused fallback slot - optional)
GOOGLE_TRANSLATE_API_KEY=https://script.google.com/macros/s/AKfycbx0L29E6YwIybr7u0ZuHx3ZGJnbj4rhiL8OdzN5tGb-eT0ExwKJjFu2rMgO7pzpjZEm/exec

# AGMARKNET daily mandi prices (free key at data.gov.in).
# Without it, /api/market-prices serves a labelled sample feed.
DATA_GOV_API_KEY=your_data_gov_api_key_here
# State to pull arrivals for (defaults to Maharashtra)
# MANDI_STATE=Maharashtra

# CORS origins for the React frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite persistence (defaults to <backend>/sessions.db, loans.db, harvest.db
# and advisory.db). Point these at a persistent/mounted path in production.
# SESSION_DB_PATH=/var/lib/fingrow/sessions.db
# LOANS_DB_PATH=/var/lib/fingrow/loans.db
# HARVEST_DB_PATH=/var/lib/fingrow/harvest.db
# ADVISORY_DB_PATH=/var/lib/fingrow/advisory.db
