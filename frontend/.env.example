# Backend API base URL.
#
# Leave unset for local development: Vite proxies /api to http://localhost:8000
# (see vite.config.js), which keeps requests same-origin and avoids CORS.
#
# REQUIRED in production when the frontend is deployed separately from the
# backend (e.g. the frontend on Vercel, the API elsewhere). Point it at the
# deployed backend, including the /api suffix:
#   VITE_API_URL=https://your-backend.example.com/api
# VITE_API_URL=
